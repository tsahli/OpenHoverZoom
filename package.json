{
  "name": "openhoverzoom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clean-room, auditable hover-to-preview Chrome extension.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run audit:bundle",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
